# Fine-riga fissi: lo SHA256 di setup-pc.ps1 deve combaciare tra il file nel
# repo, la copia servita da GitHub raw e quella verificata dalla CI. Senza
# questo, un checkout con autocrlf cambierebbe i byte e l'hash non tornerebbe.
*.ps1       text eol=lf
*.sha256    text eol=lf
*.sh        text eol=lf
*.command   text eol=lf
*.html      text eol=lf
*.url       text eol=lf
*.md        text
*.yml       text eol=lf
*.psd1      text eol=lf
# I file batch restano CRLF (formato Windows) ANCHE nel repository: con
# "text eol=crlf" git li salvava LF e GitHub raw serviva un .bat solo-LF (cmd.exe
# con fine riga LF sbaglia goto/etichette). "-text" = byte salvati tali e quali.
*.bat       -text
# File distribuiti sulla chiavetta tramite manifest.txt: byte identici tra
# repository, GitHub raw e checkout Windows (gli hash del manifest devono tornare).
manifest.txt text eol=lf
LEGGIMI.md   text eol=lf
wifi/*       -text

# Escludi file e cartelle di sviluppo dallo ZIP scaricato da GitHub ("Download ZIP")
# cosi' chi scarica il pacchetto da GitHub ottiene SOLO i file ordinati per la chiavetta USB.
.agents                       export-ignore
.github                       export-ignore
.gitattributes                export-ignore
.gitignore                    export-ignore
AGENTS.md                     export-ignore
CHANGELOG.md                  export-ignore
CLAUDE.md                     export-ignore
LICENSE.md                    export-ignore
PARITA.md                     export-ignore
PSScriptAnalyzerSettings.psd1 export-ignore
README.md                     export-ignore
SECURITY.md                   export-ignore
docs                          export-ignore
pannello                      export-ignore
remote                        export-ignore
tests                         export-ignore
tools                         export-ignore
